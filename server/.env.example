PORT=5000
NODE_ENV=development
# Local development URL; production must use the public HTTPS application URL.
APP_BASE_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/intellmeet
MONGO_DB_NAME=intellmeet
# Required in all environments; use a long, random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret
# Set true only when intentionally using volatile in-memory storage during local development.
ALLOW_LOCAL_FALLBACK=false
# Create a Resend API key and configure it only on the server. Never use a VITE_ variable.
RESEND_API_KEY=your_resend_api_key
# Use an address on a domain verified in Resend.
EMAIL_FROM="IntellMeet <invitations@your-verified-domain.example>"
